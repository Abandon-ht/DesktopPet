{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktoppet.local/schemas/avatar-pack-v4.json",
  "title": "DesktopPet local avatar pack v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name",
    "renderer",
    "entry",
    "interaction",
    "actions",
    "expression_profile",
    "license"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "renderer": {
      "const": "live2d_mocari"
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "body",
        "anchor",
        "regions"
      ],
      "properties": {
        "head": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "maxItems": 32,
          "description": "Strictly convex polygon; runtime validates convexity. Top-left normalized 5:6 viewport."
        },
        "body": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "maxItems": 32,
          "description": "Strictly convex polygon; runtime validates convexity. Top-left normalized 5:6 viewport."
        },
        "anchor": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "window_perch_y": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.8,
          "default": 0.5,
          "description": "Normalized vertical contact line for another app window top, independent of the floor foot anchor."
        },
        "regions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 12,
          "additionalProperties": false,
          "properties": {
            "face": {
              "$ref": "#/$defs/hit_polygon"
            },
            "left_hand": {
              "$ref": "#/$defs/hit_polygon"
            },
            "right_hand": {
              "$ref": "#/$defs/hit_polygon"
            },
            "upper_body": {
              "$ref": "#/$defs/hit_polygon"
            },
            "lower_body": {
              "$ref": "#/$defs/hit_polygon"
            },
            "left_arm": {
              "$ref": "#/$defs/hit_polygon"
            },
            "right_arm": {
              "$ref": "#/$defs/hit_polygon"
            },
            "abdomen": {
              "$ref": "#/$defs/hit_polygon"
            },
            "left_leg": {
              "$ref": "#/$defs/hit_polygon"
            },
            "right_leg": {
              "$ref": "#/$defs/hit_polygon"
            },
            "left_foot": {
              "$ref": "#/$defs/hit_polygon"
            },
            "right_foot": {
              "$ref": "#/$defs/hit_polygon"
            }
          },
          "description": "Optional fine hit zones checked before the broad head/body polygons; viewport top-left normalized."
        },
        "region_parts": {
          "type": "object",
          "maxProperties": 12,
          "additionalProperties": false,
          "properties": {
            "face": {
              "$ref": "#/$defs/hit_polygon_parts"
            },
            "left_hand": {
              "$ref": "#/$defs/hit_polygon_parts"
            },
            "right_hand": {
              "$ref": "#/$defs/hit_polygon_parts"
            },
            "left_arm": {
              "$ref": "#/$defs/hit_polygon_parts"
            },
            "right_arm": {
              "$ref": "#/$defs/hit_polygon_parts"
            },
            "abdomen": {
              "$ref": "#/$defs/hit_polygon_parts"
            },
            "left_leg": {
              "$ref": "#/$defs/hit_polygon_parts"
            },
            "right_leg": {
              "$ref": "#/$defs/hit_polygon_parts"
            },
            "left_foot": {
              "$ref": "#/$defs/hit_polygon_parts"
            },
            "right_foot": {
              "$ref": "#/$defs/hit_polygon_parts"
            },
            "upper_body": {
              "$ref": "#/$defs/hit_polygon_parts"
            },
            "lower_body": {
              "$ref": "#/$defs/hit_polygon_parts"
            }
          },
          "description": "Optional convex pieces added to an existing fine region; runtime requires each key in regions and checks the same region priority."
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "head_pat": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "expression",
                "duration_ms"
              ],
              "properties": {
                "expression": {
                  "type": "string",
                  "minLength": 1
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 5000
                }
              }
            }
          ]
        },
        "body_tap": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "expression",
                "duration_ms"
              ],
              "properties": {
                "expression": {
                  "type": "string",
                  "minLength": 1
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 5000
                }
              }
            }
          ]
        },
        "feed": {
          "$ref": "#/$defs/optional_action"
        },
        "play": {
          "$ref": "#/$defs/optional_action"
        },
        "rest": {
          "$ref": "#/$defs/optional_action"
        },
        "greet": {
          "$ref": "#/$defs/optional_action"
        },
        "peek": {
          "$ref": "#/$defs/optional_action"
        },
        "invite": {
          "$ref": "#/$defs/optional_action"
        }
      }
    },
    "parameter_map": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string"
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "redistributable"
      ],
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "licensed",
            "original"
          ]
        },
        "redistributable": {
          "type": "boolean"
        }
      }
    },
    "expression_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog",
        "baseline",
        "reactions"
      ],
      "properties": {
        "catalog": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "patternProperties": {
            "^[A-Za-z0-9_-]{1,64}$": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "label"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          },
          "additionalProperties": false
        },
        "baseline": {
          "type": "object",
          "required": [
            "neutral"
          ],
          "properties": {
            "neutral": {
              "type": "string",
              "minLength": 1
            },
            "cheerful": {
              "type": "string",
              "minLength": 1
            },
            "sad": {
              "type": "string",
              "minLength": 1
            },
            "irritable": {
              "type": "string",
              "minLength": 1
            },
            "tired": {
              "type": "string",
              "minLength": 1
            },
            "depleted": {
              "type": "string",
              "minLength": 1
            },
            "starving": {
              "type": "string",
              "minLength": 1
            },
            "affectionate": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "reactions": {
          "type": "object",
          "properties": {
            "head_pat": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expression",
                  "duration_ms"
                ],
                "properties": {
                  "expression": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000
                  }
                }
              }
            },
            "body_tap": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expression",
                  "duration_ms"
                ],
                "properties": {
                  "expression": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000
                  }
                }
              }
            },
            "feed": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expression",
                  "duration_ms"
                ],
                "properties": {
                  "expression": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000
                  }
                }
              }
            },
            "play": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expression",
                  "duration_ms"
                ],
                "properties": {
                  "expression": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000
                  }
                }
              }
            },
            "rest": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expression",
                  "duration_ms"
                ],
                "properties": {
                  "expression": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000
                  }
                }
              }
            },
            "greet": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expression",
                  "duration_ms"
                ],
                "properties": {
                  "expression": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000
                  }
                }
              }
            },
            "peek": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expression",
                  "duration_ms"
                ],
                "properties": {
                  "expression": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000
                  }
                }
              }
            },
            "invite": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expression",
                  "duration_ms"
                ],
                "properties": {
                  "expression": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000
                  }
                }
              }
            },
            "celebrate": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expression",
                  "duration_ms"
                ],
                "properties": {
                  "expression": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000
                  }
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "touch_reactions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "head_wary": {
          "$ref": "#/$defs/touch_stages"
        },
        "head_warm": {
          "$ref": "#/$defs/touch_stages"
        },
        "head_close": {
          "$ref": "#/$defs/touch_stages"
        },
        "face_wary": {
          "$ref": "#/$defs/touch_stages"
        },
        "face_warm": {
          "$ref": "#/$defs/touch_stages"
        },
        "face_close": {
          "$ref": "#/$defs/touch_stages"
        },
        "hand_wary": {
          "$ref": "#/$defs/touch_stages"
        },
        "hand_warm": {
          "$ref": "#/$defs/touch_stages"
        },
        "hand_close": {
          "$ref": "#/$defs/touch_stages"
        },
        "arm": {
          "$ref": "#/$defs/touch_stages"
        },
        "uneasy": {
          "$ref": "#/$defs/touch_stages"
        },
        "discomfort": {
          "$ref": "#/$defs/touch_stages"
        },
        "boundary_first": {
          "$ref": "#/$defs/touch_stages"
        },
        "boundary_second": {
          "$ref": "#/$defs/touch_stages"
        },
        "boundary_third": {
          "$ref": "#/$defs/touch_stages"
        }
      },
      "description": "Optional semantic touch cues; each stage references expression_profile.catalog."
    },
    "touch_variants": {
      "type": "object",
      "propertyNames": {
        "enum": ["face", "left_hand", "right_hand"]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "uniqueItems": true,
        "items": {
          "enum": ["head_wary", "head_warm", "head_close", "face_wary", "face_warm", "face_close", "hand_wary", "hand_warm", "hand_close", "arm", "uneasy", "discomfort", "boundary_first", "boundary_second", "boundary_third"]
        }
      },
      "description": "Optional region based cue choices; runtime validates that every choice is bound in touch_reactions."
    }
  },
  "$defs": {
    "optional_action": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expression",
            "duration_ms"
          ],
          "properties": {
            "expression": {
              "type": "string",
              "minLength": 1
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 5000
            }
          }
        }
      ]
    },
    "hit_polygon_parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/hit_polygon"
      }
    },
    "hit_polygon": {
      "type": "array",
      "minItems": 3,
      "maxItems": 32,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "description": "Strictly convex polygon; runtime validates geometry."
    },
    "touch_stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expression",
          "duration_ms"
        ],
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 10000
          }
        }
      }
    }
  }
}
